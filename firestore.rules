rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if ownsUserData(uid);
      allow list: if false;
      function validProfile() {
        return ownsUserData(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'phoneNumber', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.updatedAt == request.time;
      }
      allow create: if validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUserData(uid);

      match /trustedContacts/{contactId} {
        allow get, list: if ownsUserData(uid);
        allow create: if ownsUserData(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'phoneNumber', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+91[6-9][0-9]{9}$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsUserData(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'phoneNumber', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+91[6-9][0-9]{9}$')
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUserData(uid);
      }
    }
  }
}
