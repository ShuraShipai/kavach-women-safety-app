rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if ownsUserData(uid);
      allow list: if false;
      function validProfile() {
        return ownsUserData(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'phoneNumber', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phoneNumber == request.auth.token.phone_number
        && request.resource.data.updatedAt == request.time;
      }
      allow create: if validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if validProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUserData(uid);

      match /trustedContacts/{contactId} {
        allow get, list: if ownsUserData(uid);
        allow create: if ownsUserData(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'phoneNumber', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+91[6-9][0-9]{9}$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsUserData(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'phoneNumber', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^\\+91[6-9][0-9]{9}$')
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUserData(uid);
      }
    }

    function validReport(data) {
      return data.keys().hasOnly([
          'location', 'category', 'timeOfDay', 'note', 'moderationStatus', 'createdAt'
        ])
        && data.location is latlng
        && data.category in ['unsafe', 'poorLighting']
        && data.timeOfDay in ['morning', 'afternoon', 'evening', 'night']
        && (data.note == null || (data.note is string && data.note.size() <= 240))
        && data.moderationStatus == 'pending'
        && data.createdAt == request.time;
    }

    match /safetyReports/{reportId} {
      function publicEligible() {
        return resource.data.moderationStatus == 'approved'
          && resource.data.createdAt > request.time - duration.value(30, 'd');
      }
      function publicApproved() {
        return resource.data.moderationStatus == 'approved';
      }
      function authorCanReadPending() {
        return request.auth != null
          && resource.data.moderationStatus == 'pending'
          && exists(/databases/$(database)/documents/safetyReportAuthors/$(reportId))
          && get(/databases/$(database)/documents/safetyReportAuthors/$(reportId)).data.authorUid == request.auth.uid;
      }
      allow get: if publicEligible() || authorCanReadPending();
      // Rolling time cutoffs cannot be proven from a client query constraint.
      // The app drops expired records before rendering; direct gets remain time-limited.
      allow list: if publicApproved();
      allow create: if request.auth != null
        && validReport(request.resource.data)
        && getAfter(/databases/$(database)/documents/safetyReportAuthors/$(reportId)).data.authorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /safetyReportAuthors/{reportId} {
      allow get: if request.auth != null && resource.data.authorUid == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/safetyReports/$(reportId)).data.moderationStatus == 'pending';
      allow update, delete: if false;
    }

    match /verifiedHelpPoints/{pointId} {
      allow get, list: if resource.data.type == 'policeStation'
        && resource.data.active == true
        && resource.data.verified == true;
      allow create, update, delete: if false;
    }
  }
}
